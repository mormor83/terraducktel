.env

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Node / UI build artifacts
node_modules/
dist/

# Claude Code per-project session state (settings.local.json, scheduled_tasks.lock)
# Ignore local Claude state, but DO track the project-scoped skill so a
# fresh clone picks it up without anyone running `tdt skill install`.
.claude/*
!.claude/skills/

# Local test venv
services/api/.venv/
services/cli/.venv/
.coverage
htmlcov/
# MkDocs build output (see mkdocs.yml)
site/
