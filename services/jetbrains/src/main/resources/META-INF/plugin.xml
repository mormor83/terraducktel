<idea-plugin>
  <id>com.terraducktel.jetbrains</id>
  <name>Terraducktel</name>
  <vendor url="https://github.com/mormor83/terraducktel">Terraducktel</vendor>
  <description><![CDATA[
    Terraducktel (TDT) inside your IDE: workspaces and runs trees, plan / apply / destroy with
    live step output, plan review, gated approvals, and approval notifications — against any
    self-hosted Terraducktel deployment. Sign in with email + password, an API key, or SSO.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Terraducktel" displayType="BALLOON"/>
    <notificationGroup id="Terraducktel approvals" displayType="STICKY_BALLOON"/>
    <applicationConfigurable parentId="tools" instance="com.terraducktel.jetbrains.settings.TdtConfigurable"
                              id="com.terraducktel.jetbrains.settings" displayName="Terraducktel"/>
    <backgroundPostStartupActivity implementation="com.terraducktel.jetbrains.session.TdtSessionStarter"/>
    <backgroundPostStartupActivity implementation="com.terraducktel.jetbrains.notifications.ApprovalService$Starter"/>
    <toolWindow id="Terraducktel" anchor="left" icon="/icons/tdt.svg"
                factoryClass="com.terraducktel.jetbrains.toolwindow.TdtToolWindowFactory"/>
    <statusBarWidgetFactory id="Terraducktel.Profile" implementation="com.terraducktel.jetbrains.editor.ProfileStatusBarWidgetFactory"
                             order="before Terraducktel.CurrentFile"/>
    <statusBarWidgetFactory id="Terraducktel.CurrentFile" implementation="com.terraducktel.jetbrains.editor.TdtStatusBarWidgetFactory"
                             order="after Position"/>
  </extensions>
  <actions>
    <action id="Terraducktel.Plan" class="com.terraducktel.jetbrains.actions.workspace.PlanAction" text="Plan"/>
    <action id="Terraducktel.Apply" class="com.terraducktel.jetbrains.actions.workspace.ApplyAction" text="Apply"/>
    <action id="Terraducktel.Destroy" class="com.terraducktel.jetbrains.actions.workspace.DestroyAction" text="Destroy…"/>
    <action id="Terraducktel.SetBranch" class="com.terraducktel.jetbrains.actions.workspace.SetBranchAction" text="Set Tracked Branch…"/>
    <action id="Terraducktel.Sync" class="com.terraducktel.jetbrains.actions.workspace.SyncWorkspaceAction" text="Sync From Repo"/>
    <action id="Terraducktel.OpenInBrowser" class="com.terraducktel.jetbrains.actions.workspace.OpenInBrowserAction" text="Open in Browser"/>
    <action id="Terraducktel.CopyId" class="com.terraducktel.jetbrains.actions.workspace.CopyIdAction" text="Copy Id"/>
    <action id="Terraducktel.WatchRun" class="com.terraducktel.jetbrains.actions.run.WatchRunAction" text="Watch Run…" description="Watch a run's live output"/>
    <action id="Terraducktel.ShowPlan" class="com.terraducktel.jetbrains.actions.run.ShowPlanAction" text="Show Plan" description="Open the run's plan output"/>
    <action id="Terraducktel.Approve" class="com.terraducktel.jetbrains.actions.run.ApproveAction" text="Approve…" description="Approve a run awaiting approval"/>
    <action id="Terraducktel.Reject" class="com.terraducktel.jetbrains.actions.run.RejectAction" text="Reject…" description="Reject a run awaiting approval"/>
    <action id="Terraducktel.CancelRun" class="com.terraducktel.jetbrains.actions.run.CancelRunAction" text="Cancel Run" description="Request cancellation of a run"/>
    <action id="Terraducktel.PlanCurrentFile" class="com.terraducktel.jetbrains.actions.editor.PlanCurrentFileAction"
            text="Plan This Leaf" description="Plan the Terraducktel workspace covering the active file"/>
    <action id="Terraducktel.RevealCurrentWorkspace" class="com.terraducktel.jetbrains.actions.editor.RevealCurrentWorkspaceAction"
            text="Reveal Workspace" description="Reveal the active file's workspace in the tool window"/>
    <action id="Terraducktel.CurrentFileActions" class="com.terraducktel.jetbrains.actions.editor.CurrentFileActionsAction"
            text="Terraducktel Actions for Current File" description="Show actions for the Terraducktel workspace mapped to the active file"/>
    <group id="Terraducktel.Toolbar">
      <action id="Terraducktel.SignIn" class="com.terraducktel.jetbrains.actions.auth.SignInAction" text="Sign In…" icon="AllIcons.Actions.Execute"/>
      <action id="Terraducktel.SignOut" class="com.terraducktel.jetbrains.actions.auth.SignOutAction" text="Sign Out"/>
      <action id="Terraducktel.SwitchProfile" class="com.terraducktel.jetbrains.actions.auth.SwitchProfileAction" text="Switch Profile…"/>
      <action id="Terraducktel.SwitchBu" class="com.terraducktel.jetbrains.actions.auth.SwitchBusinessUnitAction" text="Switch Business Unit…"/>
      <action id="Terraducktel.Refresh" class="com.terraducktel.jetbrains.actions.RefreshAction" text="Refresh" icon="AllIcons.Actions.Refresh"/>
      <reference ref="Terraducktel.WatchRun"/>
    </group>
    <group id="Terraducktel.ToolsMenu" text="Terraducktel" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <reference ref="Terraducktel.SignIn"/>
      <reference ref="Terraducktel.SignOut"/>
      <reference ref="Terraducktel.SwitchProfile"/>
      <reference ref="Terraducktel.SwitchBu"/>
      <separator/>
      <reference ref="Terraducktel.WatchRun"/>
      <separator/>
      <reference ref="Terraducktel.PlanCurrentFile"/>
      <reference ref="Terraducktel.RevealCurrentWorkspace"/>
    </group>
    <group id="Terraducktel.EditorMenu" text="Terraducktel" popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <reference ref="Terraducktel.PlanCurrentFile"/>
      <reference ref="Terraducktel.RevealCurrentWorkspace"/>
    </group>
    <!-- Installed as the Workspaces/Runs trees' context menus by
         TreePanel/WorkspacesPanel/RunsPanel. -->
    <group id="Terraducktel.WorkspaceMenu" popup="true">
      <reference ref="Terraducktel.Plan"/>
      <reference ref="Terraducktel.Apply"/>
      <reference ref="Terraducktel.Destroy"/>
      <separator/>
      <reference ref="Terraducktel.SetBranch"/>
      <reference ref="Terraducktel.Sync"/>
      <separator/>
      <reference ref="Terraducktel.OpenInBrowser"/>
      <reference ref="Terraducktel.CopyId"/>
    </group>
    <group id="Terraducktel.RunMenu" popup="true">
      <reference ref="Terraducktel.ShowPlan"/>
      <reference ref="Terraducktel.Approve"/>
      <reference ref="Terraducktel.Reject"/>
      <reference ref="Terraducktel.CancelRun"/>
      <separator/>
      <reference ref="Terraducktel.WatchRun"/>
      <reference ref="Terraducktel.OpenInBrowser"/>
      <reference ref="Terraducktel.CopyId"/>
    </group>
  </actions>
</idea-plugin>
